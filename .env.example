# Spring local process settings. Spring does not automatically load this file.
# Generate secrets locally; never commit actual keys or JWTs.
JWT_SECRET_BASE64=
AI_INTERNAL_API_KEY=
AI_SERVICE_BASE_URL=http://127.0.0.1:8000
AI_SERVICE_CONNECT_TIMEOUT=2s
AI_SERVICE_READ_TIMEOUT=20s
INTEGRATION_INTERNAL_API_KEY=
INTEGRATION_SERVICE_BASE_URL=http://127.0.0.1:3001
INTEGRATION_CONNECT_TIMEOUT=2s
INTEGRATION_READ_TIMEOUT=3s

# FastAPI-specific settings belong in ai-service/.env (see its .env.example).
# Node-specific settings belong in integration-service/.env (see its .env.example).
# AI_INTERNAL_API_KEY must match FastAPI INTERNAL_API_KEY.
# INTEGRATION_INTERNAL_API_KEY must match Node's variable of the same name.
# Spring MySQL settings (export into the Spring process environment).
DB_URL=jdbc:mysql://localhost:3306/personal-financedb
DB_USERNAME=root
DB_PASSWORD="#Rocafort09:)"

# Docker Compose provisioning. Set DB_USERNAME/DB_PASSWORD above to the same values.
MYSQL_DATABASE=personal-financedb
MYSQL_USER=root
MYSQL_PASSWORD="#Rocafort09:)"
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
