# Local development placeholders only. Replace passwords in your ignored .env.
# Keep values unquoted and on one line for the README's simple PowerShell loader.
MYSQL_DATABASE=personal_finance
MYSQL_USER="root"
MYSQL_PASSWORD=replace_me_mysql_dev
MYSQL_ROOT_PASSWORD=replace_me_mysql_root_dev
MYSQL_PORT=3306

MONGO_INITDB_ROOT_USERNAME=mongo_dev
MONGO_INITDB_ROOT_PASSWORD=replace_me_mongo_dev
MONGO_PORT=27017

# Milestone 7D: FastAPI uses local MongoDB; H2 remains the Spring database.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=personal_finance_ai
# Set matching generated internal secrets in each service's environment.
AI_INTERNAL_API_KEY=
INTERNAL_API_KEY=
