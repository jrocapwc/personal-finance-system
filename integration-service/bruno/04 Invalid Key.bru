meta {
  name: Invalid Key
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/internal/mock-transactions
  body: none
  auth: none
}

headers {
  X-Internal-API-Key: invalid-test-key
}

tests {
  test("Internal authentication is required", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().code).to.equal("UNAUTHORIZED");
  });
}
