meta {
  name: Mock Import Owner Override
  type: http
  seq: 51
}

post {
  url: {{baseUrl}}/api/v1/transactions/import/mock?userId=untrusted-owner
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Client ownership overrides are rejected", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().code).to.equal("INVALID_REQUEST");
  });
}
