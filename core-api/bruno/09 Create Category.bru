meta {
  name: Create Category
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Car Loan",
    "type": "EXPENSE",
    "color": "#4F46E5",
    "createdAt": "2026-10-19T13:15:04.559Z",
    "updatedAt": "2026-10-19T13:15:04.559Z"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8080
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("categoryId", res.body.id);
  } else {
    bru.deleteVar("categoryId");
  }
}
