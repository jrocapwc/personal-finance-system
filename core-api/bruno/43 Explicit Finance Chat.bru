meta {
  name: Explicit Finance Chat
  type: http
  seq: 42
}

post {
  url: {{baseUrl}}/api/v1/chat/messages
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "mode": "FINANCE",
    "question": "Explain my income, expenses, savings and budgets.",
    "month": 11,
    "year": 2026
  }
}

vars:pre-request {
  baseUrl: http://localhost:8080
}

tests {
  test("Expected HTTP status", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
