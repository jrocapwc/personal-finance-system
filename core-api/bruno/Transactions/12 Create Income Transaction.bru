meta {
  name: Create Income Transaction
  type: http
  seq: 12
}
post {
  url: {{baseUrl}}/api/v1/transactions
  body: json
  auth: bearer
}
auth:bearer {
  token: {{accessToken}}
}
body:json {
  {
    "categoryId": {{incomeCategoryId}},
    "type": "INCOME",
    "amount": 50000.00,
    "description": "Fictional monthly salary",
    "transactionDate": "{{transactionDate}}"
  }
}
script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("incomeTransactionId", res.getBody().id);
  } else {
    bru.deleteVar("incomeTransactionId");
  }
}
