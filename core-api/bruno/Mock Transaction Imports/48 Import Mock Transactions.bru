meta {
  name: Import Mock Transactions
  type: http
  seq: 48
}

post {
  url: {{baseUrl}}/api/v1/transactions/import/mock
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Successful import accounts for every fictional record", function () {
    expect(res.getStatus()).to.equal(200);
    const result = res.getBody();
    expect(result.totalProcessed).to.equal(5);
    expect(result.importedCount + result.skippedCount + result.failedCount).to.equal(result.totalProcessed);
  });
}
