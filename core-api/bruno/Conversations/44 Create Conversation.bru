meta {
  name: Create Conversation
  type: http
  seq: 44
}

post {
  url: {{baseUrl}}/api/v1/chat/conversations
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {"mode": "GENERAL", "title": "Learning Python"}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("conversationId", res.getBody().id);
  }
}

tests {
  test("Expected HTTP status", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
