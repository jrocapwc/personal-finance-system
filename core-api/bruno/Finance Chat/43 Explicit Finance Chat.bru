meta {
  name: Explicit Finance Chat
  type: http
  seq: 42
}

post {
  url: {{baseUrl}}/api/v1/chat/messages
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "mode": "FINANCE",
    "question": "How much did I spend this month?",
    "month": {{month}},
    "year": {{year}}
  }
}

tests {
  test("Expected HTTP status", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
