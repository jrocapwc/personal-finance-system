meta {
  name: Create Budget
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/v1/budgets
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "categoryId": 11,
    "month": 10,
    "year": 2026,
    "monthlyLimit": 20000.00,
    "alertThreshold": 80
  }
}

vars:pre-request {
  baseUrl: http://localhost:8080
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("budgetId", res.body.id);
  } else {
    bru.deleteVar("budgetId");
  }
}
