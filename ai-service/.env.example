# Copy to ignored ai-service/.env for automatic loading; process variables take precedence.
# Generate a random internal credential of at least 32 bytes in the launching shell.
INTERNAL_API_KEY=
# Optional: leave both blank for deterministic, no-cost rule-based chat.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=3
OPENAI_MAX_OUTPUT_TOKENS=800
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=personal_finance_ai
