      {
        "categoryId": 1,
        "categoryName": "Food",
        "amount": "400.00"
      },
      {
        "categoryId": 2,
        "categoryName": "Housing",
        "amount": "450.00"
      }
    ],
    "budgetUtilization": [
      {
        "categoryId": 1,
